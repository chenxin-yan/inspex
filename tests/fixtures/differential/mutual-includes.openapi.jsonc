// Shaped schemas that include each other through allOf, anyOf or oneOf. TypeScript cannot express that
// (upstream's `{ x } & components["schemas"]["B"]` and its mirror are TS2502), and dropping the references
// would lose required members, so inspex types them `unknown` and reports them.
{
	"openapi": "3.1.0",
	"info": { "title": "mutual includes", "version": "1" },
	"paths": {},
	"components": {
		"schemas": {
			"AllA": { "type": "object", "required": ["x"], "properties": { "x": { "type": "string" } }, "allOf": [{ "$ref": "#/components/schemas/AllB" }] },
			"AllB": { "type": "object", "required": ["y"], "properties": { "y": { "type": "number" } }, "allOf": [{ "$ref": "#/components/schemas/AllA" }] },
			"AnyA": { "type": "object", "properties": { "x": { "type": "string" } }, "anyOf": [{ "$ref": "#/components/schemas/AnyB" }] },
			"AnyB": { "type": "object", "properties": { "y": { "type": "number" } }, "anyOf": [{ "$ref": "#/components/schemas/AnyA" }] },
			"OneA": { "type": "object", "properties": { "x": { "type": "string" } }, "oneOf": [{ "$ref": "#/components/schemas/OneB" }] },
			"OneB": { "type": "object", "properties": { "y": { "type": "number" } }, "oneOf": [{ "$ref": "#/components/schemas/OneA" }] }
		}
	}
}
